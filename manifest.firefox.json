{
  "manifest_version": 3,
  "name": "NerdMeet - Google Meet Analytics & Live Tracker",
  "version": "2.0.0",
  "description": "Live attendance, speaking talk-time duration, hand raise queue, and participation analytics for Google Meet.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ]
  },
  "action": {
    "default_title": "NerdMeet Analytics",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "NerdMeet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nerdmeet@nerdmeet.local",
      "strict_min_version": "109.0"
    },
    "safari": {
      "strict_min_version": "15.4"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
